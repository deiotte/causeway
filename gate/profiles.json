{
  "$comment": "Derived profile resolution and check inventory. See gate/gate-configuration.md.",
  "$authority": "spine_version here is what APPLIES. system.json spine.closed_against is history. See gate-configuration.md §4.",
  "spine_version": "0.8",
  "resolution": {
    "default_criticality_class": "C1",
    "tier_required": true,
    "matrix": {
      "operational": { "C3": "G0", "C2": "G1", "C1": "G1" },
      "mission":     { "C3": "G1", "C2": "G2", "C1": "G2" },
      "core":        { "C3": "G2", "C2": "G3", "C1": "G3" }
    }
  },
  "release_state": {
    "$comment": "Derived lifecycle marker read by tests-with-source. See gate-configuration.md §4. oneway-closure listed it as evidence from v0.5 to v0.7 and never reached a verdict through it; v0.8 removed the listing — ADR 0034.",
    "$redefined": "v0.7 replaced 'annotated tags only' with ranked release evidence. Tag topology is not a security property, and filtering on it excluded real releases while admitting forged ones — gate-configuration.md §4 property 3, ADR 0033.",
    "default_tag_pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+",
    "override": "ato-gate.json spine.release_tag_pattern",
    "$ordering": "First match wins. Ordered by how much each source proves; the receipt records release_proof beside release_state.",
    "evidence": [
      { "proof": "signed-statement", "reads": "bundle/release.statement verified against bundle/allowed-signers under the causeway-release namespace, naming this commit" },
      { "proof": "annotated-tag",    "reads": "an annotated tag matching default_tag_pattern" },
      { "proof": "lightweight-tag",  "reads": "a lightweight tag matching default_tag_pattern" },
      { "proof": "platform-record",  "reads": "a release record published outside git", "supplied_by": null,
        "$note": "No input class supplies this. Gate configuration v0.7 open item 14." }
    ],
    "values": ["pre_release", "released"],
    "proof_values": ["signed-statement", "annotated-tag", "lightweight-tag", "platform-record", "none"]
  },
  "modifiers": {
    "$comment": "A modifier downgrades a blocking cell to a finding under a stated condition. It never promotes a finding to a block and never adds a check.",
    "adoption-horizon": {
      "downgrades": "block -> warn",
      "while": "the unclosed row is inside its adoption horizon",
      "spec": "gate-configuration.md §4 (Adoption horizon — the arithmetic)"
    },
    "pre-release": {
      "downgrades": "block -> warn",
      "while": "release_state(repo) == pre_release",
      "spec": "gate-configuration.md §4 (release_state)"
    }
  },
